# Dockerfile for the Hours WS/HTTP server on Fly.
# Only runs server/live.ts (and its imports). Next.js app is deployed
# separately to Vercel.

FROM node:22-slim AS base
WORKDIR /app

# Install prod dependencies
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund

# We need tsx to execute TypeScript directly. Install it with dev deps
# restricted to just tsx (smaller image than full devDependencies).
RUN npm install tsx@^4.21.0 --no-save --no-audit --no-fund

# Copy what the server needs (server code + shared lib).
COPY server ./server
COPY lib ./lib
COPY tsconfig.json ./

ENV NODE_ENV=production
ENV LIVE_WS_PORT=8080

EXPOSE 8080

CMD ["npx", "tsx", "server/live.ts"]
