rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Keep in sync with lib/admin-emails.ts.
      return request.auth != null
        && request.auth.token.email in ['tay@life-time.co', 'taytoddpattison@gmail.com']
        && request.auth.token.email_verified == true;
    }

    // Assessments — admin reads only, all writes go through Admin SDK
    match /assessments/{assessmentId} {
      allow read: if isAdmin();
      allow write: if false;

      match /transcript/{turnId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /pipelineRuns/{runId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /observations/{obsId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /recommendations/{recId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /reportVersions/{versionId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Public reports — readable by anyone with the unguessable shareId
    match /publicReports/{shareId} {
      allow read: if true;
      allow write: if false;

      match /views/{viewId} {
        allow read: if isAdmin();
        allow create: if request.resource.data.keys().hasAll(
          ['timestamp', 'userAgent', 'ipHash']
        );
        allow update, delete: if false;
      }
    }

    // Bookings — admin reads only; writes through Admin SDK
    match /bookings/{bookingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Booking slots — all access via server actions / admin SDK.
    // Public picker hits a server action that uses admin SDK to read open slots,
    // so no client read is needed and we don't leak who's booked.
    match /bookingSlots/{slotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Prompts, users — admin only
    match /prompts/{promptId} {
      allow read, write: if isAdmin();
    }
    match /users/{uid} {
      allow read, write: if isAdmin();
    }

    // Config — public read (price etc.); admin write
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // PRD collections — server-only (Admin SDK); consents and events are
    // append-only audit data, jobs is the worker queue, benchmarks holds
    // sourced reference ranges.
    match /consents/{consentId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /jobs/{jobId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /benchmarks/{benchmarkId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
